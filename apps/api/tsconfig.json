{
  /*
    Typecheck only — SWC (nest-cli.json) does the emit, because NestJS's
    dependency injection needs decorator metadata, which type stripping can't
    produce. The shared packages are loaded from source at runtime by Node 24's
    type stripping, hence allowImportingTsExtensions.
  */
  "compilerOptions": {
    "target": "ES2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
  },
  "include": ["src"]
}
