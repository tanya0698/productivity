// Phase 1–2 tables from plan §7. Model fields are camelCase to match
// @productivity/contracts; columns are snake_case via @map.
// Add tables in deliberate migrations as each phase starts (§7.1).

generator client {
  provider = "prisma-client-js"
}

// Hosted on Supabase (ADR 0002). Both URLs point at the session pooler and end
// with `?schema=app`: the tables live in their own `app` schema, which Supabase's
// auto-generated Data API does not expose, so the NestJS API stays the only way
// in. See .env.example.
datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @db.Uuid
  email        String   @unique
  passwordHash String?  @map("password_hash")
  displayName  String   @map("display_name")
  timezone     String   @default("UTC")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  devices         Device[]
  changes         SyncChange[]
  projects        Project[]
  tasks           Task[]
  notes           Note[]
  reminders       Reminder[]
  events          CalendarEvent[]
  eventExceptions CalendarEventException[]
  habits          Habit[]
  habitLogs       HabitLog[]
  focusSessions   FocusSession[]
  goals           Goal[]
  goalMilestones  GoalMilestone[]

  @@map("users")
}

model Device {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  name       String
  platform   String // web | android | later windows | ios
  lastSeenAt DateTime? @map("last_seen_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz

  user    User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  changes SyncChange[]

  @@map("devices")
}

/// One row per accepted change, written in the same transaction as the change.
/// changeSeq is the pull cursor (plan §6.2). Writes take a per-user advisory
/// lock so sequence values commit in order.
model SyncChange {
  changeSeq      BigInt   @id @default(autoincrement()) @map("change_seq")
  userId         String   @map("user_id") @db.Uuid
  entityType     String   @map("entity_type")
  entityId       String   @map("entity_id") @db.Uuid
  operationId    String   @map("operation_id") @db.Uuid
  op             String // upsert | delete
  version        BigInt
  originDeviceId String?  @map("origin_device_id") @db.Uuid
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  device Device? @relation(fields: [originDeviceId], references: [id])

  @@unique([userId, operationId])
  @@index([userId, changeSeq])
  @@map("sync_changes")
}

model Project {
  id          String    @id @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  title       String
  description String?
  status      String    @default("active")
  startDate   DateTime? @map("start_date") @db.Date
  dueDate     DateTime? @map("due_date") @db.Date
  goalId      String?   @map("goal_id") @db.Uuid
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  version     BigInt    @default(1)

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal          Goal?           @relation(fields: [goalId], references: [id], onDelete: SetNull)
  tasks         Task[]
  notes         Note[]
  events        CalendarEvent[]
  focusSessions FocusSession[]

  @@index([userId, updatedAt])
  @@map("projects")
}

model Task {
  id                 String    @id @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  projectId          String?   @map("project_id") @db.Uuid
  parentTaskId       String?   @map("parent_task_id") @db.Uuid
  title              String
  description        String?
  status             String    @default("inbox")
  priority           Int       @default(2) @db.SmallInt
  // Due "on a day" vs due "at a time" are different things.
  dueDate            DateTime? @map("due_date") @db.Date
  dueAt              DateTime? @map("due_at") @db.Timestamptz
  startDate          DateTime? @map("start_date") @db.Date
  completedAt        DateTime? @map("completed_at") @db.Timestamptz
  recurrenceRule     String?   @map("recurrence_rule")
  recurrenceTimezone String?   @map("recurrence_timezone")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  version            BigInt    @default(1)

  user          User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  project       Project?        @relation(fields: [projectId], references: [id], onDelete: SetNull)
  parent        Task?           @relation("Subtasks", fields: [parentTaskId], references: [id], onDelete: Cascade)
  subtasks      Task[]          @relation("Subtasks")
  events        CalendarEvent[]
  focusSessions FocusSession[]
  reminders     Reminder[]

  @@index([userId, updatedAt])
  @@index([userId, dueDate])
  @@index([userId, dueAt])
  @@map("tasks")
}

model Note {
  id         String    @id @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  projectId  String?   @map("project_id") @db.Uuid
  folderId   String?   @map("folder_id") @db.Uuid
  title      String    @default("")
  body       Json      @default("{}")
  // Plain text extracted on save. Full-text search uses a generated tsvector
  // column `search_vector` + GIN index added by hand in the init migration
  // (plan §7.2); Prisma can't declare it. scripts/new-migration.mjs keeps
  // generated migrations from dropping it.
  bodyText   String    @default("") @map("body_text")
  pinned     Boolean   @default(false)
  archivedAt DateTime? @map("archived_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt  DateTime? @map("deleted_at") @db.Timestamptz
  version    BigInt    @default(1)

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  project   Project?   @relation(fields: [projectId], references: [id], onDelete: SetNull)
  reminders Reminder[]

  @@index([userId, updatedAt])
  @@map("notes")
}

/// Plan §7.2 / §8.2. Typed nullable links (at most one set; none = standalone).
/// `remindAt` is the first occurrence; repeats keep the same wall-clock time in
/// `timezone`. `lastHandledAt` is the occurrence most recently dismissed, so a
/// repeating reminder moves on without rewriting its start. `eventId` arrives
/// is set for a one-off calendar event's reminder.
model Reminder {
  id             String    @id @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  taskId         String?   @map("task_id") @db.Uuid
  noteId         String?   @map("note_id") @db.Uuid
  eventId        String?   @map("event_id") @db.Uuid
  title          String?
  remindAt       DateTime  @map("remind_at") @db.Timestamptz
  timezone       String
  recurrenceRule String?   @map("recurrence_rule")
  status         String    @default("scheduled") // scheduled | snoozed | dismissed | done
  snoozedUntil   DateTime? @map("snoozed_until") @db.Timestamptz
  lastHandledAt  DateTime? @map("last_handled_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  version        BigInt    @default(1)

  user  User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  task  Task?          @relation(fields: [taskId], references: [id], onDelete: Cascade)
  note  Note?          @relation(fields: [noteId], references: [id], onDelete: Cascade)
  event CalendarEvent? @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([userId, remindAt])
  @@map("reminders")
}

/// Plan §7.2. Timed: wall-clock local_start/local_end + IANA timezone, with
/// starts_at/ends_at the first occurrence as instants. All-day: start_date and
/// end_date (exclusive). The CHECK enforcing one shape is in the migration.
model CalendarEvent {
  id             String    @id @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  projectId      String?   @map("project_id") @db.Uuid
  taskId         String?   @map("task_id") @db.Uuid
  title          String
  description    String?
  allDay         Boolean   @default(false) @map("all_day")
  localStart     DateTime? @map("local_start") @db.Timestamp(0)
  localEnd       DateTime? @map("local_end") @db.Timestamp(0)
  timezone       String?
  startsAt       DateTime? @map("starts_at") @db.Timestamptz
  endsAt         DateTime? @map("ends_at") @db.Timestamptz
  startDate      DateTime? @map("start_date") @db.Date
  endDate        DateTime? @map("end_date") @db.Date
  recurrenceRule String?   @map("recurrence_rule")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  version        BigInt    @default(1)

  user       User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  project    Project?                 @relation(fields: [projectId], references: [id], onDelete: SetNull)
  task       Task?                    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  exceptions CalendarEventException[]
  reminders  Reminder[]

  @@index([userId, updatedAt])
  @@index([userId, startsAt])
  @@index([userId, startDate])
  @@map("calendar_events")
}

/// "Move or cancel just this occurrence" of a repeating event (plan §7.2).
model CalendarEventException {
  id                 String    @id @db.Uuid
  userId             String    @map("user_id") @db.Uuid
  eventId            String    @map("event_id") @db.Uuid
  originalOccurrence DateTime  @map("original_occurrence") @db.Timestamp(0)
  cancelled          Boolean   @default(false)
  overrideLocalStart DateTime? @map("override_local_start") @db.Timestamp(0)
  overrideLocalEnd   DateTime? @map("override_local_end") @db.Timestamp(0)
  overrideTitle      String?   @map("override_title")
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt          DateTime? @map("deleted_at") @db.Timestamptz
  version            BigInt    @default(1)

  user  User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  event CalendarEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, originalOccurrence])
  @@index([userId, updatedAt])
  @@map("calendar_event_exceptions")
}

/// Phase 5. Daily habits may be limited to some ISO weekdays (1 = Monday);
/// weekly ones count completions per week against target_count.
model Habit {
  id          String    @id @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  goalId      String?   @map("goal_id") @db.Uuid
  title       String
  description String?
  cadence     String    @default("daily") // daily | weekly
  /// Empty = every day.
  daysOfWeek  Int[]     @map("days_of_week") @db.SmallInt
  targetCount Int       @default(1) @map("target_count") @db.SmallInt
  archivedAt  DateTime? @map("archived_at") @db.Timestamptz
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime? @map("deleted_at") @db.Timestamptz
  version     BigInt    @default(1)

  user User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  logs HabitLog[]

  @@index([userId, updatedAt])
  @@map("habits")
}

/// Append-only (plan §7.3): added or tombstoned, never edited.
model HabitLog {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  habitId   String    @map("habit_id") @db.Uuid
  date      DateTime  @db.Date
  count     Int       @default(1) @db.SmallInt
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  version   BigInt    @default(1)

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  habit Habit @relation(fields: [habitId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@index([habitId, date])
  @@map("habit_logs")
}

/// Append-only: one row per finished focus or break session.
model FocusSession {
  id              String    @id @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  taskId          String?   @map("task_id") @db.Uuid
  projectId       String?   @map("project_id") @db.Uuid
  kind            String    @default("focus") // focus | break
  startedAt       DateTime  @map("started_at") @db.Timestamptz
  endedAt         DateTime  @map("ended_at") @db.Timestamptz
  plannedMinutes  Int       @map("planned_minutes") @db.SmallInt
  durationSeconds Int       @map("duration_seconds")
  completed       Boolean   @default(false)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt       DateTime? @map("deleted_at") @db.Timestamptz
  version         BigInt    @default(1)

  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  task    Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId, updatedAt])
  @@index([userId, startedAt])
  @@map("focus_sessions")
}

model Goal {
  id             String    @id @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  title          String
  description    String?
  status         String    @default("active") // active | achieved | dropped
  targetDate     DateTime? @map("target_date") @db.Date
  reviewCadence  String?   @map("review_cadence") // weekly | monthly
  lastReviewedAt DateTime? @map("last_reviewed_at") @db.Timestamptz
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt      DateTime? @map("deleted_at") @db.Timestamptz
  version        BigInt    @default(1)

  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  milestones GoalMilestone[]
  projects   Project[]
  habits     Habit[]

  @@index([userId, updatedAt])
  @@map("goals")
}

model GoalMilestone {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  goalId    String    @map("goal_id") @db.Uuid
  title     String
  dueDate   DateTime? @map("due_date") @db.Date
  doneAt    DateTime? @map("done_at") @db.Timestamptz
  position  Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt DateTime? @map("deleted_at") @db.Timestamptz
  version   BigInt    @default(1)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([userId, updatedAt])
  @@map("goal_milestones")
}
