# Copy to apps/web/.env.local. Everything VITE_* is public: it ends up in the browser.

# Where the dev server forwards /api (the NestJS app in apps/api).
VITE_API_PROXY_TARGET=http://localhost:3000

# Supabase Auth (ADR 0003). Supabase dashboard → Settings → API Keys.
# The publishable key is meant to be public; never put the secret key here.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
