# Copy to apps/mobile/.env. Everything EXPO_PUBLIC_* is public: it ends up in the app.

# Where the phone reaches the API (apps/api). The default suits the Android
# emulator, where 10.0.2.2 is your computer. On a real phone on the same Wi-Fi,
# use your computer's LAN address, and allow port 3000 through its firewall:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000/api

# Supabase Auth (ADR 0003): same project and publishable key as the web app.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Where password-reset links open: the web app, which asks for the new password.
# Locally that's the Vite dev server (open the link on the computer running it);
# once the web app is hosted, use its address. Must be in Supabase's redirect URLs.
# EXPO_PUBLIC_WEB_URL=http://localhost:5173
