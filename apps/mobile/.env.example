# Copy to apps/mobile/.env. Everything EXPO_PUBLIC_* is public: it ends up in the app.

# Where the phone reaches the API (apps/api). The default suits the Android
# emulator, where 10.0.2.2 is your computer. On a real phone on the same Wi-Fi,
# use your computer's LAN address, and allow port 3000 through its firewall:
# EXPO_PUBLIC_API_URL=http://192.168.1.50:3000/api
