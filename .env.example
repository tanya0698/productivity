# Copy to .env at the repo root (never commit .env). Read by apps/api, apps/worker
# and the Prisma scripts. The web app has its own apps/web/.env.example.

# ─── Database: Supabase (ADR 0002) ───────────────────────────────────────────
# Supabase dashboard → Connect → "Direct" tab → "Session pooler". Use that string
# for BOTH values below, and append ?schema=app&sslmode=require&connect_timeout=30
#   schema=app        the tables live in the `app` schema, which Supabase's Data
#                     API does not expose
#   sslmode, timeout  without these, `prisma migrate` failed with P1001 even
#                     though the pooler was reachable
#
# Why the session pooler: the "Direct connection" is IPv6-only without the paid
# IPv4 add-on, and the "Transaction pooler" (port 6543) breaks Prisma's prepared
# statements and the per-user advisory lock sync relies on.
#
# Looks like:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=app&sslmode=require&connect_timeout=30
DATABASE_URL=
# Used by migrations. Same session-pooler string is fine.
DIRECT_URL=

API_PORT=3000

# ─── Auth: Supabase Auth (ADR 0003) ──────────────────────────────────────────
# Your project URL (Supabase dashboard → Settings → API). The API verifies
# sign-in tokens against this project's public signing keys; no secret needed.
SUPABASE_URL=https://<project-ref>.supabase.co

# Optional, for `npm run auth:check` only: creates the demo accounts and issues
# a password-reset link without a real inbox. Dashboard → Settings → API Keys →
# Secret key. Full admin access: keep it in this git-ignored file, never in a
# VITE_/EXPO_PUBLIC_ variable, and never in the apps. The API doesn't use it.
SUPABASE_SECRET_KEY=

# Development only, for scripts like `npm run sync:check`: when true, a request
# with NO token acts as DEV_USER_ID. A request with a token is always verified,
# and this never applies when NODE_ENV=production.
ALLOW_DEV_USER=false
DEV_USER_ID=00000000-0000-4000-8000-000000000001
