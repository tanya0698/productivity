# Copy to .env at the repo root (never commit .env). Read by apps/api, apps/worker
# and the Prisma scripts. The web app has its own apps/web/.env.example.

# ─── Database: Supabase (ADR 0002) ───────────────────────────────────────────
# Supabase dashboard → Connect → "Direct" tab → "Session pooler". Two strings
# from the same pooler host, each with ?schema=app&sslmode=require&connect_timeout=30
#   schema=app        the tables live in the `app` schema, which Supabase's Data
#                     API does not expose
#   sslmode, timeout  without these, `prisma migrate` failed with P1001 even
#                     though the pooler was reachable
#
# DATABASE_URL (the API and worker at run time): the TRANSACTION pooler, port
# 6543, plus &pgbouncer=true&connection_limit=3.
#   Why: the session pooler (5432) keeps one of a handful of free-tier slots for
#   every open connection, and each Prisma client opens about nine. With the
#   local API, a worker and the hosted API all connected, the slots ran out and
#   requests timed out (sync stopped). The transaction pooler holds a slot only
#   for each query or transaction, so they share it.
#   pgbouncer=true    Prisma stops using prepared statements, which the
#                     transaction pooler can't carry between queries
#   connection_limit  caps each process's pool
#   The sync's per-user lock is pg_advisory_xact_lock, held only for its own
#   transaction, so it works through the transaction pooler.
#
# DIRECT_URL (migrations only): the SESSION pooler, port 5432. Migrations need
# a whole session. (The "Direct connection" is IPv6-only without the paid IPv4
# add-on, so the session pooler stands in for it.)
#
# Looks like:
#   DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?schema=app&sslmode=require&connect_timeout=30&pgbouncer=true&connection_limit=3
#   DIRECT_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=app&sslmode=require&connect_timeout=30
DATABASE_URL=
DIRECT_URL=

API_PORT=3000

# ─── Auth: Supabase Auth (ADR 0003) ──────────────────────────────────────────
# Your project URL (Supabase dashboard → Settings → API). The API verifies
# sign-in tokens against this project's public signing keys; no secret needed.
SUPABASE_URL=https://<project-ref>.supabase.co

# Optional, for `npm run auth:check` only: creates the demo accounts and issues
# a password-reset link without a real inbox. Dashboard → Settings → API Keys →
# Secret key. Full admin access: keep it in this git-ignored file, never in a
# VITE_/EXPO_PUBLIC_ variable, and never in the apps. The API doesn't use it.
SUPABASE_SECRET_KEY=

# Development only, for scripts like `npm run sync:check`: when true, a request
# with NO token acts as DEV_USER_ID. A request with a token is always verified,
# and this never applies when NODE_ENV=production.
ALLOW_DEV_USER=false
DEV_USER_ID=00000000-0000-4000-8000-000000000001

# Web push (plan §8.1), used by the API (public key, test sends) and the worker
# (sending due reminders). Generate a pair with:
#   node -e "console.log(require('web-push').generateVAPIDKeys())"
# The private key is a secret: server-side only. VAPID_SUBJECT is a contact
# address push services can use (mailto: or https:).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# Phone push (the Android app, through Firebase Cloud Messaging). In the Firebase
# console: Project settings → Service accounts → Generate new private key. Save
# the file at the repo root under this name (git-ignored: it's a secret). The
# API and worker read it; without it, phones only get the alarms they schedule.
# The Android app also needs that project's google-services.json in apps/mobile.
FIREBASE_SERVICE_ACCOUNT_FILE=firebase-service-account.json
